PROD_DISCORD_TOKEN=
DEV_DISCORD_TOKEN=
PANEL_API_KEY=

# AES-256-GCM key for encrypting stored client API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

ADMIN_DISCORD_ID=
PROD_CLIENT_ID=
PROD_GUILD_ID=
DEV_CLIENT_ID=
DEV_GUILD_ID=

PANEL_URL=https://panel.example.com/

# Uptime integration (used by /info command)
# UPTIME_PROVIDER: "kuma" (default)
# UPTIME_URL:     base URL of your status host (no trailing slash)
# UPTIME_SLUG:    status page slug (Kuma)
# UPTIME_PANEL_MONITOR_ID / UPTIME_NODE_MONITOR_ID: Kuma monitor IDs to query
# UPTIME_API_KEY: bearer token for the custom provider only (read-only key)

UPTIME_PROVIDER=kuma
UPTIME_URL=https://uptime.example.com
UPTIME_SLUG=your-status-page-slug
UPTIME_PANEL_MONITOR_ID=1
UPTIME_NODE_MONITOR_ID=2
UPTIME_API_KEY=

# Curseforge Integration (used by /install-modpack command)
# CURSEFORGE_API_KEY: API key for Curseforge API (required)
CURSEFORGE_API_KEY=