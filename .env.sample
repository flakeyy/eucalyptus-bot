PROD_DISCORD_TOKEN=
DEV_DISCORD_TOKEN=
PANEL_API_KEY=

# AES-256-GCM key for encrypting stored client API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

ADMIN_DISCORD_ID=
PROD_CLIENT_ID=
PROD_GUILD_ID=
DEV_CLIENT_ID=
DEV_GUILD_ID=

PANEL_URL=https://panel.example.com/

# Uptime Kuma integration (used by /info command)
# UPTIME_URL: base URL of your Uptime Kuma instance (no trailing slash)
# UPTIME_SLUG: status page slug configured in Uptime Kuma
UPTIME_URL=https://uptime.example.com
UPTIME_SLUG=your-status-page-slug